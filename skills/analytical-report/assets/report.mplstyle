# Report chart style for matplotlib: plt.style.use("<path>/report.mplstyle")
# Quiet axes, direct labels, one accent color; grey everything that isn't the point.

figure.figsize: 8, 4.5
figure.dpi: 110
figure.facecolor: white
savefig.bbox: tight
savefig.facecolor: white
svg.fonttype: none

font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 11
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 12
axes.labelsize: 10
axes.labelcolor: 4B5563
axes.edgecolor: D1D5DB
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler("color", ["2563EB", "9CA3AF", "F59E0B", "10B981", "EF4444", "8B5CF6"])

grid.color: E5E7EB
grid.linewidth: 0.8

xtick.color: 4B5563
ytick.color: 4B5563
xtick.labelsize: 10
ytick.labelsize: 10
xtick.major.size: 0
ytick.major.size: 0

lines.linewidth: 2.2
lines.markersize: 5
patch.edgecolor: white

legend.frameon: False
legend.fontsize: 10
